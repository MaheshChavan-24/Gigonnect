    tools {
      name: "create_file"
      description: "Create a new file. Any parent directories will be created for you if they do not already exist. Follow these rules:\n1. By default this tool will error if TargetFile already exists. To overwrite an existing file, set Overwrite to true.\n2. IMPORTANT: Do not create an empty file then immediately modify it using the edit_file tool. Instead, specify the content of the file in the Content argument of this tool."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"TargetFile\":{\"type\":\"string\",\"description\":\"The target file to modify. This must be an absolute path starting with /. Always specify the target file as the very first argument.\"},\"Content\":{\"type\":\"string\",\"description\":\"The content to write to the file. Leave this empty to create an empty file.\"},\"Overwrite\":{\"type\":\"boolean\",\"description\":\"Set this to true to overwrite an existing file. WARNING: This will replace the entire file contents. Only use when you explicitly intend to overwrite. Otherwise, use a code edit tool to modify existing files.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"TargetFile\",\"Overwrite\",\"toolSummary\",\"toolAction\"]}"
      original_name: "create_file"
    }
    tools {
      name: "delete_file"
      description: "Delete an existing file. Follow these rules:\n1. ONLY use this tool to delete files that exist. Always first confirm that TargetFile exists before calling this tool.\n2. Be extremely careful when using this tool as file deletion is irreversible."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"TargetFile\":{\"type\":\"string\",\"description\":\"The target file to delete. This must be an absolute path starting with /. Always specify the target file as the very first argument.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"TargetFile\",\"toolSummary\",\"toolAction\"]}"
      original_name: "delete_file"
    }
    tools {
      name: "edit_file"
      description: "Edit an existing file. Follow these rules:\n1. Before editing, use view_file to see the file\'s current content. Do not assume content based on templates or prior knowledge.\n2. Use this tool ONLY when you are making a SINGLE CONTIGUOUS block of edits to the same file (i.e. replacing a single contiguous block of text). If you are making edits to multiple non-adjacent lines, use the multi_edit_file tool instead.\n3. Do NOT make multiple parallel calls to this tool or the multi_edit_file tool for the same file.\n4. To edit multiple, non-adjacent lines of code in the same file, make a single call to the multi_edit_file tool. DO NOT try to replace the entire existing content with the new content, this is very expensive\n5. In TargetContent, specify the precise lines to edit. These lines MUST EXACTLY MATCH text in the existing file content. In ReplacementContent, specify the replacement content for the specified target content. This must be a complete drop-in replacement of the TargetContent, with necessary modifications made.\n6. IMPORTANT: The TargetContent MUST be a unique substring within the file. Otherwise, the tool call will error out."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"TargetContent\":{\"type\":\"string\",\"description\":\"The exact string to be replaced. This must be the exact character-sequence to be replaced, including whitespace. Be very careful to include any leading whitespace otherwise this will not work at all. This must be a unique substring within the file, or else it will error.\"},\"ReplacementContent\":{\"type\":\"string\",\"description\":\"The content to replace the target content with.\"},\"TargetFile\":{\"type\":\"string\",\"description\":\"The target file to modify. This must be an absolute path starting with /. Always specify the target file as the very first argument.\"},\"Instruction\":{\"type\":\"string\",\"description\":\"A short, high-level description of the changes that you are making to the file. This should not contain any actual code.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"TargetContent\",\"ReplacementContent\",\"TargetFile\",\"Instruction\",\"toolSummary\",\"toolAction\"]}"
      original_name: "edit_file"
    }
    tools {
      name: "multi_edit_file"
      description: "Edit an existing file. Follow these rules:\n1. Before editing, use view_file to see the file\'s current content. Do not assume content based on templates or prior knowledge.\n2. Use this tool ONLY when you are making MULTIPLE, NON-CONTIGUOUS edits to the same file (i.e., you are changing more than one separate block of text). If you are making a single contiguous block of edits, use the edit_file tool instead.\n3. Do NOT use this tool if you are only editing a single contiguous block of lines.\n4. Do NOT make multiple parallel calls to this tool or the edit_file tool for the same file.\n5. To edit multiple, non-adjacent lines of code in the same file, make a single call to this tool. Specify each edit as a separate ReplacementChunk. DO NOT try to replace the entire existing content with the new content, this is very expensive.\n6. For each ReplacementChunk, specify TargetContent and ReplacementContent. In TargetContent, specify the precise lines to edit. These lines MUST EXACTLY MATCH text in the existing file content. In ReplacementContent, specify the replacement content for the specified target content. This must be a complete drop-in replacement of the TargetContent, with necessary modifications made.\n7. If you are making multiple edits across a single file, specify multiple separate ReplacementChunks.\n8. IMPORTANT: The TargetContent of each ReplacementChunk MUST be a unique substring within the file. Otherwise, the tool call will error out."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"TargetFile\":{\"type\":\"string\",\"description\":\"The target file to modify. This must be an absolute path starting with /. Always specify the target file as the very first argument.\"},\"ReplacementChunks\":{\"items\":{\"properties\":{\"TargetContent\":{\"type\":\"string\",\"description\":\"The exact string to be replaced. This must be the exact character-sequence to be replaced, including whitespace. Be very careful to include any leading whitespace otherwise this will not work at all. This must be a unique substring within the file, or else it will error.\"},\"ReplacementContent\":{\"type\":\"string\",\"description\":\"The content to replace the target content with.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"TargetContent\",\"ReplacementContent\"]},\"type\":\"array\",\"description\":\"A list of chunks to replace. It is best to provide multiple chunks for non-contiguous edits if possible. This must be a JSON array, not a string.\"},\"Instruction\":{\"type\":\"string\",\"description\":\"A short, high-level description of the changes that you are making to the file. This should not contain any actual code.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"TargetFile\",\"ReplacementChunks\",\"Instruction\",\"toolSummary\",\"toolAction\"]}"
      original_name: "multi_edit_file"
    }
    tools {
      name: "list_dir"
      description: "List the contents of a directory, i.e. all files and subdirectories that are children of the directory."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"DirectoryPath\":{\"type\":\"string\",\"description\":\"The path to the directory to list contents of. This must be an absolute path starting with /.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"DirectoryPath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "list_dir"
    }
    tools {
      name: "delete_dir"
      description: "Delete a directory. Follow these rules:\n1. ONLY use this tool to delete directories that exist. Always first confirm that the directory exists before calling this tool.\n2. Be extremely careful when using this tool as directory deletion is irreversible.\n3. Use force=false to delete only empty directories (safer).\n4. Use force=true to recursively delete all contents (dangerous - use with caution)."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"DirectoryPath\":{\"type\":\"string\",\"description\":\"The path to the directory to delete. This must be an absolute path starting with /.\"},\"Force\":{\"type\":\"boolean\",\"description\":\"If true, recursively delete all files and subdirectories. If false, only delete empty directories, and error if the directory is not empty. Defaults to false.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"DirectoryPath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "delete_dir"
    }
    tools {
      name: "move"
      description: "Move a file or directory to a new path. This operation can be used to rename files/directories or move them to different locations. Any parent directories of the destination path will be created for you if they do not already exist. The source path must exist and the destination path must not exist."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"SourcePath\":{\"type\":\"string\",\"description\":\"The path to the source file or directory to move. This must be an absolute path starting with /.\"},\"DestinationPath\":{\"type\":\"string\",\"description\":\"The path to the destination location. This must be an absolute path starting with /.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"SourcePath\",\"DestinationPath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "move"
    }
    tools {
      name: "view_file"
      description: "Text file usage:\n\t\t\t- The lines of the file are 1-indexed\n\t\t\t- You can view at most 1600 lines at a time\n\t\t\t- Specify StartLine and EndLine to view the lines of the file using slice notation:\n\t\t\t  - Omit both to view the entire file, or the first 1600 lines of the file, whichever is smaller.\n\t\t\t  - Specify StartLine only to view the remaining lines of the file, or the next 1600 lines, whichever is smaller\n\t\t\t  - Specify EndLine only to view the remaining preceding lines of the file, or the previous 1600 lines, whichever is smaller\n\t\t\t  - Specify both to view a precise line range. This range must be smaller than 1600 lines or only the first 1600 lines of the range will be shown."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"AbsolutePath\":{\"type\":\"string\",\"description\":\"The path to the file to view. This must be an absolute path starting with /.\"},\"StartLine\":{\"type\":\"integer\",\"description\":\"Optional. Startline to view, 1-indexed, inclusive. When specified, this value must be less than or equal to EndLine.\"},\"EndLine\":{\"type\":\"integer\",\"description\":\"Optional. Endline to view, 1-indexed, inclusive. When specified, this value must be greater than or equal to StartLine.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"AbsolutePath\",\"toolSummary\",\"toolAction\"]}"
      original_name: "view_file"
    }
    tools {
      name: "compile_applet"
      description: "Checks if the AI Studio applet builds successfully. This tool calls the build\n\t\tsystem; if the build succeeds, it returns a message indicating success. If the build fails, it\n\t\tprovides an error message and detailed build output logs to help identify and fix issues. Use\n\t\tthis tool after making code changes to verify correct applet compilation."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"toolSummary\",\"toolAction\"]}"
      original_name: "compile_applet"
    }
    tools {
      name: "search_web"
      description: "Performs a web search for a given query. Returns a summary of relevant information along with URL citations."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"query\":{\"type\":\"string\"},\"domain\":{\"type\":\"string\",\"description\":\"Optional domain to recommend the search prioritize\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"query\",\"toolSummary\",\"toolAction\"]}"
