        lines {
          text: "            text = if (isHindi) \"\340\244\250\340\244\262\340\244\270\340\244\276\340\244\234\340\245\200, \340\244\254\340\244\242\340\244\274\340\244\210\340\244\227\340\245\200\340\244\260\340\245\200, \340\244\254\340\244\277\340\244\234\340\244\262\340\245\200 \340\244\225\340\244\276 \340\244\225\340\244\276\340\244\256 \340\244\224\340\244\260 15+ \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\244\277\340\244\257\340\244\276\340\244\202\340\245\244 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\206\340\244\252\340\244\276\340\244\244\340\244\225\340\244\276\340\244\262\340\245\200\340\244\250 \340\244\270\340\244\271\340\244\276\340\244\257\340\244\244\340\244\276 \340\244\257\340\244\276 \340\244\205\340\244\250\340\245\201\340\244\270\340\245\202\340\244\232\340\244\277\340\244\244 \340\244\254\340\245\201\340\244\225\340\244\277\340\244\202\340\244\227\340\245\244\" else \"Plumbing, electrical, carpentry & 15+ trade categories. Instant emergency repairs or scheduled visits.\","
