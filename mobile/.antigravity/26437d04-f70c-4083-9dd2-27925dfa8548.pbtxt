= 16.sp\\n            )\\n\\n            Spacer(modifier = Modifier.height(10.dp))\\n\\n            Row(\\n                modifier = Modifier.fillMaxWidth(),\\n                horizontalArrangement = Arrangement.SpaceBetween,\\n                verticalAlignment = Alignment.CenterVertically\\n            ) {\\n                Text(\\n                    text = \\\"Proposed: \342\202\271${item.budget.toInt()}\\\",\\n                    fontSize = 14.sp,\\n                    fontWeight = FontWeight.Bold,\\n                    color = MaterialTheme.colorScheme.primary\\n                )\\n\\n                if (item.workerNotes != null) {\\n                    Text(\\n                        text = \\\"Note: ${item.workerNotes}\\\",\\n                        fontSize = 11.sp,\\n                        color = Color.DarkGray\\n                    )\\n                }\\n            }\\n        }\\n    }\\n}\\n\",\"Overwrite\":true,\"TargetFile\":\"/app/src/main/java/com/example/ui/screens/client/MyServiceRequestsScreen.kt\",\"toolAction\":\"Creating MyServiceRequestsScreen\",\"toolSummary\":\"Create client booking requests screen\"}"
