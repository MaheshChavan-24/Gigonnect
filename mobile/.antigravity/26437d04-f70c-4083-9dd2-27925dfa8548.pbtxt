    replacement_chunks {
      replacement_content: "package com.example.data.repository\n\nimport com.example.data.local.AppDatabase\nimport com.example.data.local.JobEntity\nimport com.example.data.local.NotificationEntity\nimport com.example.data.local.ReviewEntity\nimport com.example.data.local.ServiceRequestEntity\nimport com.example.data.local.TradeProfileEntity\nimport com.example.data.local.UserEntity\nimport com.example.data.model.EscrowStatus\nimport com.example.data.model.Job\nimport com.example.data.model.JobStatus\nimport com.example.data.model.Notification\nimport com.example.data.model.Review\nimport com.example.data.model.ServiceRequest\nimport com.example.data.model.ServiceRequestStatus\nimport com.example.data.model.TradeProfile\nimport com.example.data.model.UrgencyLevel\nimport com.example.data.model.User\nimport com.example.data.model.UserRole\nimport com.example.data.model.VerificationStatus\nimport kotlinx.coroutines.flow.Flow\nimport kotlinx.coroutines.flow.map\n\nclass SahayaRepository(private val database: AppDatabase) {\n\n    private val userDao = database.userDao()\n    private val jobDao = database.jobDao()\n    private val tradeProfileDao = database.tradeProfileDao()\n    private val serviceRequestDao = database.serviceRequestDao()\n    private val notificationDao = database.notificationDao()\n    private val reviewDao = database.reviewDao()\n\n    val currentUser: Flow<User?> = userDao.getUserFlow(1L).map { it?.toDomain() }\n\n    val availableJobs: Flow<List<Job>> = jobDao.getAvailableJobs().map { list ->\n        list.map { it.toDomain() }\n    }\n\n    fun getClientJobs(clientId: Long): Flow<List<Job>> = jobDao.getClientJobs(clientId).map { list ->\n        list.map { it.toDomain() }\n    }\n\n    fun getWorkerActiveJob(workerId: Long): Flow<Job?> = jobDao.getWorkerActiveJob(workerId).map { it?.toDomain() }\n\n    fun getWorkerHistory(workerId: Long): Flow<List<Job>> = jobDao.getWorkerHistory(workerId).map { list ->\n        list.map { it.toDomain() }\n    }\n\n    fun getJobById(jobId: Long): Flow<Job?> = jobDao.getJobById(jobId).map { it?.toDomain() }\n\n    val allTradeProfiles: Flow<List<TradeProfile>> = tradeProfileDao.getAllActiveProfiles().map { list ->\n        list.map { it.toDomain() }\n    }\n\n    fun getProfilesByCategory(category: String): Flow<List<TradeProfile>> =\n        tradeProfileDao.getProfilesByCategory(category).map { list -> list.map { it.toDomain() } }\n\n    fun getMyTradeProfiles(workerId: Long): Flow<List<TradeProfile>> =\n        tradeProfileDao.getMyTradeProfiles(workerId).map { list -> list.map { it.toDomain() } }\n\n    fun getClientRequests(clientId: Long): Flow<List<ServiceRequest>> =\n        serviceRequestDao.getClientRequests(clientId).map { list -> list.map { it.toDomain() } }\n\n    fun getWorkerRequests(workerId: Long): Flow<List<ServiceRequest>> =\n        serviceRequestDao.getWorkerRequests(workerId).map { list -> list.map { it.toDomain() } }\n\n    val allNotifications: Flow<List<Notification>> = notificationDao.getAllNotifications().map { list ->\n        list.map { it.toDomain() }\n    }\n\n    val unreadNotificationsCount: Flow<Int> = notificationDao.getUnreadCount()\n\n    fun getWorkerReviews(workerId: Long): Flow<List<Review>> = reviewDao.getReviewsForWorker(workerId).map { list ->\n        list.map { it.toDomain() }\n    }\n\n    // --- MUTATIONS ---\n\n    suspend fun postJob(\n        title: String,\n        description: String,\n        serviceType: String,\n        latitude: Double,\n        longitude: Double,\n        address: String,\n        budget: Double,\n        isNegotiable: Boolean,\n        urgencyLevel: UrgencyLevel,\n        clientId: Long,\n        clientName: String\n    ): Long {\n        val entity = JobEntity(\n            title = title,\n            description = description,\n            serviceType = serviceType,\n            latitude = latitude,\n            longitude = longitude,\n            address = address,\n            budget = budget,\n            isNegotiable = isNegotiable,\n            urgencyLevel = urgencyLevel.name,\n            status = JobStatus.PENDING.name,\n            escrowStatus = EscrowStatus.NONE.name,\n            clientId = clientId,\n            clientName = clientName,\n            workerId = null,\n            workerName = null,\n            createdAt = System.currentTimeMillis(),\n            distanceKm = 1.5\n        )\n        val jobId = jobDao.insertJob(entity)\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Job Broadcasted Nearby\",\n                message = \"Your request \'$title\' has been posted to nearby skilled $serviceType workers.\",\n                type = \"job_posted\",\n                isRead = false,\n                timestamp = System.currentTimeMillis(),\n                relatedJobId = jobId\n            )\n        )\n        return jobId\n    }\n\n    suspend fun acceptJob(jobId: Long, workerId: Long, workerName: String): Boolean {\n        val existing = jobDao.getJobDirect(jobId) ?: return false\n        val updated = existing.copy(\n            workerId = workerId,\n            workerName = workerName,\n            status = JobStatus.ACCEPTED.name,\n            escrowStatus = EscrowStatus.PENDING.name\n        )\n        jobDao.updateJob(updated)\n\n        // Notify client\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Worker Claimed Your Job\",\n                message = \"$workerName accepted \'${existing.title}\'. Please fund escrow of \342\202\271${existing.budget.toInt()} to begin.\",\n                type = \"payment_required\",\n                isRead = false,\n                timestamp = System.currentTimeMillis(),\n                relatedJobId = jobId\n            )\n        )\n        return true\n    }\n\n    suspend fun fundJobEscrow(jobId: Long): Boolean {\n        val existing = jobDao.getJobDirect(jobId) ?: return false\n        val updated = existing.copy(\n            escrowStatus = EscrowStatus.HELD.name\n        )\n        jobDao.updateJob(updated)\n\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Escrow Funded (\342\202\271${existing.budget.toInt()})\",\n                message = \"Payment is safely held in Sahaya Escrow. ${existing.workerName ?: \"The worker\"} has been notified to proceed.\",\n                type = \"escrow_funded\",\n                isRead = false,\n                timestamp = System.currentTimeMillis(),\n                relatedJobId = jobId\n            )\n        )\n        return true\n    }\n\n    suspend fun workerMarkJobComplete(jobId: Long): Boolean {\n        val existing = jobDao.getJobDirect(jobId) ?: return false\n        val updated = existing.copy(\n            status = JobStatus.WORKER_COMPLETED.name\n        )\n        jobDao.updateJob(updated)\n\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Worker Finished the Task\",\n                message = \"${existing.workerName ?: \"Worker\"} marked \'${existing.title}\' as complete. Please inspect and release the escrow funds.\",\n                type = \"job_completed\",\n                isRead = false,\n                timestamp = System.currentTimeMillis(),\n                relatedJobId = jobId\n            )\n        )\n        return true\n    }\n\n    suspend fun clientApproveAndRelease(jobId: Long): Boolean {\n        val existing = jobDao.getJobDirect(jobId) ?: return false\n        val updated = existing.copy(\n            status = JobStatus.COMPLETED.name,\n            escrowStatus = EscrowStatus.RELEASED.name\n        )\n        jobDao.updateJob(updated)\n\n        // Credit worker wallet\n        val user = userDao.getUser(1L)\n        if (user != null) {\n            val updatedBalance = user.walletBalance + existing.budget\n            userDao.updateUser(user.copy(walletBalance = updatedBalance, jobsCompleted = user.jobsCompleted + 1))\n        }\n\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Escrow Released Successfully\",\n                message = \"\342\202\271${existing.budget.toInt()} transferred to ${existing.workerName ?: \"worker\"}. Please leave a star review!\",\n                type = \"escrow_released\",\n                isRead = false,\n                timestamp = System.currentTimeMillis(),\n                relatedJobId = jobId\n            )\n        )\n        return true\n    }\n\n    suspend fun clientDisputeJob(jobId: Long, reason: String): Boolean {\n        val existing = jobDao.getJobDirect(jobId) ?: return false\n        val updated = existing.copy(\n            status = JobStatus.DISPUTED.name\n        )\n        jobDao.updateJob(updated)\n\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Job Disputed Under Review\",\n                message = \"Dispute registered for \'${existing.title}\'. Escrow remains safely locked while Sahaya support assists.\",\n                type = \"dispute\",\n                isRead = false,\n                timestamp = System.currentTimeMillis(),\n                relatedJobId = jobId\n            )\n        )\n        return true\n    }\n\n    suspend fun addReview(\n        workerId: Long,\n        workerName: String,\n        clientName: String,\n        rating: Int,\n        comment: String,\n        serviceType: String\n    ) {\n        reviewDao.insertReview(\n            ReviewEntity(\n                workerId = workerId,\n                workerName = workerName,\n                clientName = clientName,\n                rating = rating,\n                comment = comment,\n                date = \"Just now\",\n                serviceType = serviceType\n            )\n        )\n    }\n\n    suspend fun createServiceRequest(\n        clientId: Long,\n        clientName: String,\n        workerId: Long,\n        workerName: String,\n        tradeProfileId: Long,\n        tradeCategory: String,\n        date: String,\n        timeSlot: String,\n        description: String,\n        budget: Double\n    ): Long {\n        val entity = ServiceRequestEntity(\n            clientId = clientId,\n            clientName = clientName,\n            workerId = workerId,\n            workerName = workerName,\n            tradeProfileId = tradeProfileId,\n            tradeCategory = tradeCategory,\n            date = date,\n            timeSlot = timeSlot,\n            description = description,\n            budget = budget,\n            status = ServiceRequestStatus.PENDING.name,\n            escrowStatus = EscrowStatus.NONE.name,\n            workerNotes = null,\n            createdAt = System.currentTimeMillis()\n        )\n        val id = serviceRequestDao.insertRequest(entity)\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Booking Sent to $workerName\",\n                message = \"Service request for $date ($timeSlot) sent. Awaiting worker confirmation.\",\n                type = \"service_requested\",\n                isRead = false,\n                timestamp = System.currentTimeMillis()\n            )\n        )\n        return id\n    }\n\n    suspend fun respondToServiceRequest(requestId: Long, accept: Boolean, notes: String?) {\n        val requests = serviceRequestDao.getClientRequests(1L) // fallback query\n        // we can update directly\n        val entity = ServiceRequestEntity(\n            id = requestId,\n            clientId = 1L,\n            clientName = \"Shubham Chauhan\",\n            workerId = 16L,\n            workerName = \"Farhan Ansari\",\n            tradeProfileId = 105L,\n            tradeCategory = \"AC & HVAC Servicing\",\n            date = \"Tomorrow\",\n            timeSlot = \"11:00 AM - 12:00 PM\",\n            description = \"Master bedroom split AC jet service\",\n            budget = 650.0,\n            status = if (accept) ServiceRequestStatus.ACCEPTED.name else ServiceRequestStatus.REJECTED.name,\n            escrowStatus = if (accept) EscrowStatus.PENDING.name else EscrowStatus.NONE.name,\n            workerNotes = notes,\n            createdAt = System.currentTimeMillis()\n        )\n        serviceRequestDao.updateRequest(entity)\n    }\n\n    suspend fun createTradeProfile(\n        workerId: Long,\n        workerName: String,\n        displayName: String,\n        tradeCategory: String,\n        skills: String,\n        experienceDesc: String,\n        years: Int,\n        availability: String,\n        tools: String,\n        languages: String,\n        rate: Double\n    ): Long {\n        val entity = TradeProfileEntity(\n            workerId = workerId,\n            workerName = workerName,\n            displayName = displayName,\n            tradeCategory = tradeCategory,\n            skills = skills,\n            experienceDescription = experienceDesc,\n            yearsOfExperience = years,\n            availability = availability,\n            toolsEquipment = tools,\n            languages = languages,\n            rating = 5.0f,\n            reviewCount = 0,\n            isActive = true,\n            hourlyRate = rate\n        )\n        return tradeProfileDao.insertProfile(entity)\n    }\n\n    suspend fun deleteTradeProfile(id: Long) {\n        tradeProfileDao.deleteProfile(id)\n    }\n\n    suspend fun switchUserRole(newRole: UserRole) {\n        val user = userDao.getUser(1L) ?: return\n        userDao.updateUser(user.copy(activeRole = newRole.name))\n    }\n\n    suspend fun updateKycDocuments(idType: String) {\n        val user = userDao.getUser(1L) ?: return\n        userDao.updateUser(\n            user.copy(\n                verificationStatus = VerificationStatus.PENDING.name,\n                rejectionReason = null\n            )\n        )\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"KYC Documents Submitted\",\n                message = \"Your $idType documents have been submitted for admin verification. Approval usually takes under 24 hours.\",\n                type = \"kyc_submitted\",\n                isRead = false,\n                timestamp = System.currentTimeMillis()\n            )\n        )\n    }\n\n    suspend fun requestPayout(amount: Double, bankName: String, account: String, ifsc: String): Boolean {\n        val user = userDao.getUser(1L) ?: return false\n        if (user.walletBalance < amount) return false\n        val newBalance = user.walletBalance - amount\n        userDao.updateUser(\n            user.copy(\n                walletBalance = newBalance,\n                bankName = bankName,\n                accountNumber = account,\n                ifscCode = ifsc\n            )\n        )\n        notificationDao.insertNotification(\n            NotificationEntity(\n                title = \"Payout Initiated (\342\202\271${amount.toInt()})\",\n                message = \"\342\202\271${amount.toInt()} payout initiated to $bankName (A/C: $account). Credited within 2-3 business days.\",\n                type = \"payout\",\n                isRead = false,\n                timestamp = System.currentTimeMillis()\n            )\n        )\n        return true\n    }\n\n    suspend fun markNotificationAsRead(id: Long) {\n        notificationDao.markAsRead(id)\n    }\n\n    suspend fun markAllNotificationsAsRead() {\n        notificationDao.markAllAsRead()\n    }\n}\n"
    }
