      replacement_content: "package com.example.data.local\n\nimport android.content.Context\nimport androidx.room.Database\nimport androidx.room.Room\nimport androidx.room.RoomDatabase\nimport androidx.sqlite.db.SupportSQLiteDatabase\nimport com.example.data.model.EscrowStatus\nimport com.example.data.model.JobStatus\nimport com.example.data.model.ServiceRequestStatus\nimport com.example.data.model.UrgencyLevel\nimport com.example.data.model.UserRole\nimport com.example.data.model.VerificationStatus\nimport kotlinx.coroutines.CoroutineScope\nimport kotlinx.coroutines.Dispatchers\nimport kotlinx.coroutines.launch\n\n@Database(\n    entities = [\n        UserEntity::class,\n        JobEntity::class,\n        TradeProfileEntity::class,\n        ServiceRequestEntity::class,\n        NotificationEntity::class,\n        ReviewEntity::class\n    ],\n    version = 1,\n    exportSchema = false\n)\nabstract class AppDatabase : RoomDatabase() {\n    abstract fun userDao(): UserDao\n    abstract fun jobDao(): JobDao\n    abstract fun tradeProfileDao(): TradeProfileDao\n    abstract fun serviceRequestDao(): ServiceRequestDao\n    abstract fun notificationDao(): NotificationDao\n    abstract fun reviewDao(): ReviewDao\n\n    companion object {\n        @Volatile\n        private var INSTANCE: AppDatabase? = null\n\n        fun getDatabase(context: Context, scope: CoroutineScope): AppDatabase {\n            return INSTANCE ?: synchronized(this) {\n                val instance = Room.databaseBuilder(\n                    context.applicationContext,\n                    AppDatabase::class.java,\n                    \"sahaya_marketplace.db\"\n                ).addCallback(DatabaseCallback(scope)).build()\n                INSTANCE = instance\n                instance\n            }\n        }\n\n        private class DatabaseCallback(\n            private val scope: CoroutineScope\n        ) : RoomDatabase.Callback() {\n            override fun onCreate(db: SupportSQLiteDatabase) {\n                super.onCreate(db)\n                INSTANCE?.let { database ->\n                    scope.launch(Dispatchers.IO) {\n                        populateInitialData(database)\n                    }\n                }\n            }\n        }\n\n        suspend fun populateInitialData(database: AppDatabase) {\n            val userDao = database.userDao()\n            val jobDao = database.jobDao()\n            val tradeProfileDao = database.tradeProfileDao()\n            val serviceRequestDao = database.serviceRequestDao()\n            val notificationDao = database.notificationDao()\n            val reviewDao = database.reviewDao()\n\n            // 1. Initial User (Shubham - dual role enabled)\n            userDao.insertUser(\n                UserEntity(\n                    id = 1L,\n                    username = \"shubham_c\",\n                    email = \"shubhammahekchauhan@gmail.com\",\n                    phoneNumber = \"+91 98765 43210\",\n                    isClient = true,\n                    isWorker = true,\n                    activeRole = UserRole.CLIENT.name,\n                    verificationStatus = VerificationStatus.VERIFIED.name,\n                    rejectionReason = null,\n                    walletBalance = 1250.0,\n                    bankName = \"HDFC Bank\",\n                    accountNumber = \"501004892341\",\n                    ifscCode = \"HDFC0001824\",\n                    rating = 4.9f,\n                    jobsCompleted = 18\n                )\n            )\n\n            // 2. Initial Jobs (Nearby jobs for workers + Client jobs)\n            val now = System.currentTimeMillis()\n            val seedJobs = listOf(\n                JobEntity(\n                    id = 1L,\n                    title = \"Burst Pipe Emergency in Kitchen\",\n                    description = \"Main inlet pipe behind modular kitchen cabinet leaking profusely. Water valve shut off but urgent repair required to avoid floor water damage.\"