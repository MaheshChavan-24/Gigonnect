        lines {
          text: "            text = if (isHindi) \"\340\244\225\340\245\201\340\244\266\340\244\262 \340\244\225\340\244\276\340\244\260\340\245\200\340\244\227\340\244\260 \340\244\217\340\244\265\340\244\202 \340\244\230\340\244\260\340\245\207\340\244\262\340\245\202 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202, \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\217\340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\213 \340\244\225\340\245\207 \340\244\270\340\244\276\340\244\245\" else \"Skilled Trades & Home Repairs with Secure Escrow\","
